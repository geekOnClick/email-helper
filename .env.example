# === LLM-провайдер RouterAI ===
ROUTERAI_API_KEY=ваш_ключ_из_кабинета_routerai
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Модели (по умолчанию — решения из PLAN.md)
MODEL_ORCHESTRATOR=z-ai/glm-5.2
MODEL_ANALYZER=z-ai/glm-5.2
MODEL_HELPER=z-ai/glm-5.3-flash
EMBEDDINGS_MODEL=baai/bge-m3

# === FalkorDB ===
# Примечание: порт 6379 занят другим проектом на этом хосте,
# поэтому по умолчанию мапим на 6380.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=falkordb

# === Аккаунты (JSON-массив). Скопируйте значения из agent-accounts.txt) ===
# Поля объекта: provider ('yandex'|'outlook'), login, password, authStrategy ('basic'|'oauth2', по умолчанию 'basic').
# authStrategy='oauth2' нужно для Outlook, если basic-auth отключён (см. PLAN.md 3.0).
# Пример:
# ACCOUNTS=[{"provider":"yandex","login":"agentemailtest@yandex.com","password":"..."},{"provider":"outlook","login":"alcauselove@outlook.com","password":"...","authStrategy":"oauth2"}]
ACCOUNTS=[]

# === Microsoft identity (OAuth2 для Outlook) ===
# Public client (без секрета). Для личных @outlook.com используется известный public client_id Thunderbird.
# Tenant 'consumers' — для личных @outlook.com аккаунтов.
MS_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753
MS_TENANT=consumers
# Локальное хранилище OAuth2-токенов (refresh token). Вне git (.gitignore).
OAUTH_TOKEN_STORE_PATH=./.tokens/oauth.json

# === Пути ===
DOWNLOAD_DIR=./downloads