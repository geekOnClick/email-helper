{
  "name": "email-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Агент-помощник по работе с электронной почтой (Яндекс, Outlook) — оркестратор + субагенты",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:http": "tsx src/mcp/index.ts --http",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "npm run web:dev",
    "web": "tsx src/index.ts --web",
    "web:dev": "concurrently -k -n api,web -c blue,green \"tsx src/index.ts --web\" \"vite\"",
    "web:build": "vite build"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/imapflow": "^1.0.23",
    "@types/node": "26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/smtp-server": "^3.5.13",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "smtp-server": "^3.21.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "dompurify": "^3.4.17",
    "dotenv": "18.0.9",
    "falkordb": "^7.0.0",
    "imapflow": "^2.9.1",
    "jszip": "^3.10.2",
    "mailparser": "^3.12.4",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.3.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "4.6.7"
  }
}